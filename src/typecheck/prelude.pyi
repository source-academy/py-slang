# The type predicates narrow the type of their argument, as in `0 if is_none(xs) else head(xs)`.
# (bool is not a number, as in Python §4.)
def is_none(x: object, /) -> _TypeIs[None]: ...
def is_boolean(x: object, /) -> _TypeIs[bool]: ...
def is_integer(x: object, /) -> _TypeIs[int]: ...
def is_float(x: object, /) -> _TypeIs[float]: ...
def is_complex(x: object, /) -> _TypeIs[complex]: ...
def is_number(x: object, /) -> _TypeIs[int | float | complex]: ...
def is_string(x: object, /) -> _TypeIs[str]: ...
def is_function(x: object, /) -> _TypeIs[Callable[..., object]]: ...
def is_list(x: object, /) -> _TypeIs[list[_Any]]: ...

