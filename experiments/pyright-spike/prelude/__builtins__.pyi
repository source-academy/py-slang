# Spike: type stubs for the Source Python §4 prelude (linked lists, pairs, misc, math, streams).
# Pyright merges a project-root `__builtins__.pyi` into the builtins scope.
#
# Pairs are 2-element Python lists at runtime; here they are an opaque generic so that a pair is
# not a `list` as far as the checker is concerned. A linked list is `Pair[T, LList[T]] | None`.
from typing import Any as Any, Callable as Callable, Generic, TypeIs, TypeVar, final

_H = TypeVar("_H")
_T = TypeVar("_T")
_A = TypeVar("_A")
_B = TypeVar("_B")

@final
class Pair(Generic[_H, _T]):
    def __init__(self) -> None: ...

type LList[X] = Pair[X, LList[X]] | None
type Stream[X] = Pair[X, Callable[[], Stream[X]]] | None

# ── pairs & linked lists (linked-list.ts + linked-list.prelude.ts) ───────────
def pair(h: _H, t: _T, /) -> Pair[_H, _T]: ...
def head(p: Pair[_H, Any], /) -> _H: ...
def tail(p: Pair[Any, _T], /) -> _T: ...
def is_pair(x: object, /) -> TypeIs[Pair[Any, Any]]: ...
def llist(*xs: _A) -> LList[_A]: ...
def is_llist(xs: object, /) -> bool: ...
def print_llist(xs: object, /) -> None: ...
def length(xs: LList[Any], /) -> int: ...
def map(f: Callable[[_A], _B], xs: LList[_A], /) -> LList[_B]: ...
def filter(pred: Callable[[_A], bool], xs: LList[_A], /) -> LList[_A]: ...
def reduce(f: Callable[[_A, _B], _B], initial: _B, xs: LList[_A], /) -> _B: ...
def for_each(f: Callable[[_A], object], xs: LList[_A], /) -> bool: ...
def build_llist(f: Callable[[int], _A], n: int, /) -> LList[_A]: ...
def enum_llist(start: int, end: int, /) -> LList[int]: ...
def reverse(xs: LList[_A], /) -> LList[_A]: ...
def append(xs: LList[_A], ys: LList[_A], /) -> LList[_A]: ...
def member(v: _A, xs: LList[_A], /) -> LList[_A]: ...
def remove(v: _A, xs: LList[_A], /) -> LList[_A]: ...
def remove_all(v: _A, xs: LList[_A], /) -> LList[_A]: ...
def llist_ref(xs: LList[_A], n: int, /) -> _A: ...
def llist_to_string(xs: LList[Any], /) -> str: ...

