# The types of the names that Python §4 Typed predeclares, beyond Python's own builtins
# (`print`, `len`, `abs`, `max`, `min`, `round`, `input`, `repr`, `str`, `complex` have the types
# that typeshed gives them). Pyright merges a project-root `__builtins__.pyi` into the builtins, so
# a program needs no imports. The build (scripts/build-typecheck.ts) bakes this file into the
# checker's worker.
#
# The source of the names is the stdlib groups of Python §4 (src/stdlib/*.ts and their preludes),
# and their documentation (docs/lib/*.js). src/tests/typecheck-prelude.test.ts checks that every
# name that Python §4 provides is declared here or in typeshed.
#
# What students see of this file: Pair, LList, Stream, Callable and the functions. Everything that
# starts with an underscore is private to the file, so `Any` and the type variables are not names
# that a program can use.
from typing import Any as _Any
from typing import Callable as Callable
from typing import Generic as _Generic
from typing import NoReturn as _NoReturn
from typing import TypeIs as _TypeIs
from typing import TypeVar as _TypeVar
from typing import final as _final

_H = _TypeVar("_H")
_T = _TypeVar("_T")

# A pair. At run time a pair is a list of two elements, but to the type checker it is not a list: a
# pair has a head and a tail of different types, `pair(1, 2)[0]` is an error, and the head and tail
# are read with `head` and `tail`. Both type parameters are invariant: pairs can be changed.
@_final
class Pair(_Generic[_H, _T]):
    def __init__(self) -> None: ...

# A linked list: a pair whose tail is a linked list, or None. A stream: a pair whose tail is a
# function that returns the rest of the stream, or None.
type LList[X] = Pair[X, LList[X]] | None
type Stream[X] = Pair[X, Callable[[], Stream[X]]] | None

